@startdot
digraph G {

  label="OpenTMF Libraries";
  labelloc=t;
  fontsize=16;
  fontname="Helvetica";
  rankdir=TB;
  nodesep=0.30;
  ranksep=0.55;
  pad=0.3;

  /* LAYERING RULE — a library's dependency sits either in the SAME row or in
     the row DIRECTLY ABOVE it. Never further up. That bounds every edge to a
     span of 0 or 1, which is what keeps the picture readable at a glance:
     no arrow ever travels across the whole diagram.

     Allowing span 0 is what makes it compact. Without it every dependency
     forces a new row, the rows grow to 9+ nodes, and the diagram stretches to
     ~1800px of sprawl. Placing e.g. opentmf-api-clients directly beside
     opentmf-http-clients instead costs nothing and buys a third of the width.

     Rows are declared with rank=same below. Same-row dependencies carry
     constraint=false so they do not push their node onto another rank; the
     rank=same group is what actually fixes the row. (Dropping constraint=false
     and letting them be flat edges was measured: wider and more crossings.)

     COLUMN ORDER within a row is dot's job, not ours — its crossing minimiser
     already finds the optimum here, and 400 hand-permutations of the row
     contents failed to beat it. Do not pin columns with invisible edges: that
     is what disabled the minimiser and produced the 35-crossing spaghetti this
     layout replaced.

     ARROWS point at the dependency — up to the row above, or sideways within a
     row — and read "depends on" (opentmf-camunda7 -> openid-rbac-security).
     Rows and arrowheads are separate knobs: the declaration order sets the
     row, `dir=back` sets which end carries the head. Reversing a declaration
     to aim an arrow moves the node to another row along with it. */

  node [fontsize=10, fontname="Helvetica", style=filled, penwidth=1.2];
  edge [penwidth=1.2, arrowsize=0.8, dir=back];

  /* Node declaration order is a LAYOUT LEVER, not cosmetics: it seeds dot's
     initial column ordering, and this particular order was searched for and
     lands the diagram on zero edge crossings. The row each node belongs to is
     the rank=same block below, not this order — the trailing comment on each
     line just says which. Reordering these lines is safe but will move columns
     about; re-check the picture if you do. */
  dnextmodels [label="dnext-\nv4-models",          shape=ellipse,  fillcolor="#EEDDFF", color="#AA88DD"];  /* row 2 */
  catsync     [label="dnext-catalog-\nsync-service", shape=ellipse, fillcolor="#FFE0F0", color="#DD88BB"];  /* row 3 */
  v4api       [label="opentmf-\nv4-api",           shape=ellipse,  fillcolor="#EEDDFF", color="#AA88DD"];  /* row 1 */
  v4utils     [label="opentmf-\nv4-utils",         shape=ellipse,  fillcolor="#DDEEFF", color="#88AADD"];  /* row 2 */
  outbox      [label="opentmf-outbox-\nservice",   shape=cylinder, fillcolor="#DDDDFF", color="#8888DD"];  /* row 4 */
  commons     [label="opentmf-\ncommons",          shape=ellipse,  fillcolor="#DDFFDD", color="#66BB66"];  /* row 2 */
  httpclients [label="opentmf-\nhttp-clients",     shape=ellipse,  fillcolor="#DDEEFF", color="#88AADD"];  /* row 3 */
  toolkit     [label="tmf630-\ntoolkit",           shape=ellipse,  fillcolor="#FFEEDD", color="#DDAA66"];  /* row 3 */
  bpmnsync    [label="camunda7-bpmn-\nsync-service", shape=ellipse, fillcolor="#DDFFEE", color="#66BB66"];  /* row 3 */
  security    [label="openid-rbac-\nsecurity",     shape=ellipse,  fillcolor="#FFDDDD", color="#DD8888"];  /* row 1 */
  testfw      [label="camunda7-\ntest-framework",  shape=ellipse,  fillcolor="#DDFFEE", color="#66BB66"];  /* row 2 */
  incident    [label="camunda7-\nincident-logger", shape=ellipse,  fillcolor="#DDFFEE", color="#66BB66"];  /* row 1 */
  jsonpatch   [label="opentmf-\njson-patch",       shape=ellipse,  fillcolor="#DDFFDD", color="#66BB66"];  /* row 3 */
  auditor     [label="auditor-\naware",            shape=ellipse,  fillcolor="#FFDDEE", color="#DD88BB"];  /* row 1 */
  v4models    [label="opentmf-\nv4-models",        shape=ellipse,  fillcolor="#EEDDFF", color="#AA88DD"];  /* row 2 */
  apiclients  [label="opentmf-\napi-clients",      shape=ellipse,  fillcolor="#DDEEFF", color="#88AADD"];  /* row 4 */
  kicker      [label="http-endpoint-\nkicker",     shape=box,      fillcolor="#DDDDDD", color="#999999"];  /* row 1 */
  camunda7    [label="opentmf-\ncamunda7",         shape=ellipse,  fillcolor="#DDFFEE", color="#66BB66"];  /* row 2 */
  mockserver  [label="opentmf-\nmockserver",       shape=ellipse,  fillcolor="#FFFFDD", color="#BBBB66"];  /* row 4 */
  dblock      [label="opentmf-db-\nlock-service",  shape=cylinder, fillcolor="#DDDDFF", color="#8888DD"];  /* row 3 */

  { rank=same; v4api; security; incident; auditor; kicker; }
  { rank=same; commons; v4models; dnextmodels; v4utils; camunda7; testfw; }
  { rank=same; httpclients; jsonpatch; dblock; toolkit; bpmnsync; catsync; }
  { rank=same; apiclients; mockserver; outbox; }

  /* ── Compile (solid green) ── declared dependency -> dependent ── */
  edge [style=solid, color="#228B22"];
  incident    -> testfw;
  commons     -> testfw      [constraint=false];
  incident    -> camunda7;
  security    -> camunda7;
  v4api       -> v4models;
  commons     -> v4models    [constraint=false];
  v4api       -> v4utils;
  v4api       -> dnextmodels;
  commons     -> dnextmodels [constraint=false];
  commons     -> httpclients;
  httpclients -> apiclients;
  jsonpatch   -> apiclients;
  jsonpatch   -> mockserver;
  commons     -> bpmnsync;
  dblock      -> bpmnsync    [constraint=false];
  commons     -> catsync;
  dblock      -> catsync     [constraint=false];

  /* ── Optional (dotted orange) ── */
  edge [style=dotted, color="#FF8C00"];
  httpclients -> bpmnsync    [constraint=false];
  httpclients -> catsync     [constraint=false];
  toolkit     -> outbox;

}
@enddot
